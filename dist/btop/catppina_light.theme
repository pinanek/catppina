# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f7f7f8"

# Main text color
theme[main_fg]="#303033"

# Title color for boxes
theme[title]="#303033"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#16618b"

# Background color of selected item in processes box
theme[selected_bg]="#e3e3e5"

# Foreground color of selected item in processes box
theme[selected_fg]="#16618b"

# Color of inactive/disabled text
theme[inactive_fg]="#89898e"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#974036"

# Background color of the percentage meters
theme[meter_bg]="#e3e3e5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#974036"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#41599c" #Mauve
theme[mem_box]="#186846" #Green
theme[net_box]="#984133" #Maroon
theme[proc_box]="#16618b" #Blue

# Box divider line and small boxes line color
theme[div_line]="#9d9da2"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#186846"
theme[temp_mid]="#765702"
theme[temp_end]="#a72f3a"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#00675f"
theme[cpu_mid]="#00647e"
theme[cpu_end]="#485a8c"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#41599c"
theme[free_mid]="#485a8c"
theme[free_end]="#16618b"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#00647e"
theme[cached_mid]="#16618b"
theme[cached_end]="#485a8c"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#944600"
theme[available_mid]="#984133"
theme[available_end]="#a72f3a"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#186846"
theme[used_mid]="#00675f"
theme[used_end]="#116285"

# Download graph colors (Peach -> Red)
theme[download_start]="#944600"
theme[download_mid]="#984133"
theme[download_end]="#a72f3a"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#186846"
theme[upload_mid]="#00675f"
theme[upload_end]="#116285"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#00647e"
theme[process_mid]="#485a8c"
theme[process_end]="#41599c"
