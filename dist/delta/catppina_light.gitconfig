[delta "catppina_light"]
	blame-palette = "#f7f7f8 #f1f1f2 #e9e9eb #eeeeef #e3e3e5"
	commit-decoration-style = "#9d9da2" bold box ul
	light = true
	file-decoration-style = "#9d9da2"
	file-style = "#303033"
	hunk-header-decoration-style = "#9d9da2" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#5b5b5f"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#9d9da2"
	line-numbers-minus-style = bold "#a72f3a"
	line-numbers-plus-style = bold "#186846"
	line-numbers-right-style = "#9d9da2"
	line-numbers-zero-style = "#9d9da2"
	# 35% red 65% base
	minus-emph-style = bold syntax "#dbb1b5"
	# 20% red 80% base
	minus-style = syntax "#e7cfd2"
	# 35% green 65% base
	plus-emph-style = bold syntax "#a9c5b9"
	# 20% green 80% base
	plus-style = syntax "#cbdbd4"
	map-styles = \
		bold purple => syntax "#b8c0d7", \
		bold blue => syntax "#a9c3d2", \
		bold cyan => syntax "#a7c3cf", \
		bold yellow => syntax "#cabfa2"
	# Should match the name of the bat theme
	syntax-theme = catppina_light
